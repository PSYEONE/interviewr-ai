# Copy to .env and fill in. .env is gitignored.
# All vars prefixed INTERVIEWR_ (see backend/app/config.py).

# Required: WS auth token. Generate with `openssl rand -hex 32`
INTERVIEWR_AUTH_TOKEN=

# LLM model id. For ollama: qwen3:8b, llama3.1:8b
# For gemini (free, aistudio.google.com): gemini-2.5-flash
# For groq (free, console.groq.com): llama-3.3-70b-versatile
INTERVIEWR_LLM_MODEL=

# BYOK cloud LLM (optional, not needed for local-only). Pick a provider below, set its key.
# Gemini  - free key: https://aistudio.google.com/apikey
# INTERVIEWR_GEMINI_API_KEY=
# Groq    - free key: https://console.groq.com/keys
# INTERVIEWR_GROQ_API_KEY=
# Phase 2 (not yet implemented): INTERVIEWR_ANTHROPIC_API_KEY / INTERVIEWR_OPENAI_API_KEY

# --- optional overrides ---
# INTERVIEWR_STT_PROVIDER=whisper_cpp        # whisper_cpp | groq | deepgram
# INTERVIEWR_LLM_PROVIDER=ollama             # ollama | gemini | groq (anthropic/openai: Phase 2)
# INTERVIEWR_WHISPER_MODEL=small.en         # tiny.en|base.en|small.en|medium.en (bigger = more accurate, slower)
# INTERVIEWR_WHISPER_GPU_DEVICE=-1           # Vulkan device index; -1 = default (0). Pin the discrete GPU on iGPU+dGPU laptops (check the ggml_vulkan device list at startup)
# INTERVIEWR_STT_EMIT_PARTIALS=true         # stream a live tentative tail word-by-word; false = commit-only (cheaper on CPU)
# INTERVIEWR_STT_PARTIAL_INTERVAL_S=0.4     # how often to re-transcribe for the live tail
# INTERVIEWR_AUDIO_DEVICE=                   # empty = auto-detect PipeWire default sink
# INTERVIEWR_ENABLE_REMOTE_VIEWER=false      # true binds 0.0.0.0, requires strong token
