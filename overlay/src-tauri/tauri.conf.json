{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "interviewr-ai",
  "version": "0.1.1",
  "identifier": "dev.interviewr.overlay",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "interviewr",
        "width": 760,
        "height": 460,
        "minWidth": 360,
        "minHeight": 280,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": false,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ],
    "publisher": "PSYEONE",
    "homepage": "https://github.com/PSYEONE/interviewr-ai",
    "license": "AGPL-3.0-only",
    "category": "Utility",
    "shortDescription": "Real-time interview and meeting copilot",
    "longDescription": "Captures system audio, transcribes it live, spots the questions and streams an\nanswer drawn from your resume and the job description into a native overlay.\nRuns on your machine by default: whisper.cpp on the GPU for speech, Ollama for\nthe model, with cloud providers as an option. No account, no subscription, no\ntelemetry.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libvulkan1",
          "pipewire-bin",
          "pulseaudio-utils"
        ],
        "conflicts": [
          "interviewr-overlay"
        ],
        "replaces": [
          "interviewr-overlay"
        ],
        "provides": [
          "interviewr-overlay"
        ],
        "files": {
          "/usr/lib/interviewr": "/usr/lib/interviewr"
        }
      }
    }
  }
}
